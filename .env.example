PORT=3000
SQLITE_PATH=./vin_cache.db
NHTSA_TIMEOUT_MS=8000
VEHICLES_DB_PATH=./data/vehicles_ai.db
# Stejny dlouhy nahodny klic nastavte jako CARPRICE_API_KEY v CarOffice.
VEHICLE_INGEST_API_KEY=
# Dlouhy tajny klic pro cteni ulozenych dotazu pres /search-logs.
SEARCH_LOGS_ADMIN_KEY=
GITHUB_REPO=Fojtik82/autoscan-pricing-backend
GITHUB_BRANCH=main
GITHUB_TOKEN=
GIT_AUTHOR_NAME=CarPrice DB Bot
GIT_AUTHOR_EMAIL=carprice-db-bot@users.noreply.github.com
SAUTO_LIMIT=200
SAUTO_MAX_PAGES=80
SAUTO_DETAIL_CONCURRENCY=8
SAUTO_RECONCILE_ENABLED=1
SAUTO_RECONCILE_CONCURRENCY=4
SAUTO_RECONCILE_PAGE_LIMIT=1000
SAUTO_RECONCILE_BUCKET_LIMIT=8000
SAUTO_MISSING_CHECKS_BEFORE_INACTIVE=3
SAUTO_ENABLED=1
BAZOS_ENABLED=1
BAZOS_RECONCILE_ENABLED=1
BAZOS_DAILY_LOOKBACK_DAYS=2
BAZOS_MAX_DAILY_PAGES_PER_CATEGORY=2000
BAZOS_MIN_DAILY_PAGES_PER_CATEGORY=3
BAZOS_DAILY_CONCURRENCY=2
BAZOS_DETAIL_CONCURRENCY=3
BAZOS_SITEMAP_CONCURRENCY=3
BAZOS_REQUEST_DELAY_MS=250
# Diagnostic only: set to 0 to inspect category coverage without opening details.
BAZOS_FETCH_DETAILS=1
